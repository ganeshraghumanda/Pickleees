// Vintage Bhimavaram Pickles — Environment Variables Template
// Copy this file to .env.local and fill in your values
// NEVER commit .env.local to version control

// Supabase — Public keys (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

// Supabase — Service Role Key (SERVER-SIDE ONLY — never import in 'use client' files)
SUPABASE_SERVICE_ROLE_KEY=

// Razorpay — Key ID (public, used in checkout widget)
RAZORPAY_KEY_ID=
// Razorpay — Secret (SERVER-SIDE ONLY — used for order creation & signature verification)
RAZORPAY_SECRET=
// Razorpay — Webhook Secret (SERVER-SIDE ONLY — separate from RAZORPAY_SECRET)
RAZORPAY_WEBHOOK_SECRET=

// Cloudinary — Base URL for image transformations
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
